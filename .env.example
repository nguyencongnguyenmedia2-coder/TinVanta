# ==========================================
# TINVANTA — ENVIRONMENT CONFIGURATION
# ==========================================

# 1. Ứng dụng & Domain
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="TinVanta"
NEXT_PUBLIC_SITE_DESCRIPTION="Tin tức nhanh — Thông tin chuẩn | Báo điện tử TinVanta"

# 2. Supabase Integration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# 3. AI Editorial Assistant Adapter (Gemini / OpenAI / Anthropic)
# Cho phép bật/tắt module AI độc lập
AI_ASSISTANT_ENABLED=true
AI_PROVIDER=gemini # gemini | openai | anthropic
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_MONTHLY_QUOTA_CALLS=5000

# 4. Email Provider Adapter (Resend / SMTP)
EMAIL_PROVIDER=resend # resend | smtp | mock
RESEND_API_KEY=
EMAIL_FROM=toasoan@newshub.vn
EMAIL_SUPPORT=hotro@newshub.vn

# 5. Security & Secret Keys
CRON_SECRET=super-secret-cron-token-for-scheduled-publishing
INTERNAL_API_SECRET=internal-secure-hash-token

# 6. Analytics & Advertising
ADS_FRAUD_PREVENTION_WINDOW_SECONDS=60
MAX_CLICKS_PER_IP_HOURLY=10
